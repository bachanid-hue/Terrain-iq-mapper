# Copy this file to .env in the same folder (server/.env) to enable
# "Ask AI" on the Map Collections page. Without it, everything else in the
# app works normally — the deterministic matching algorithm doesn't need
# an API key at all. This is only used for the optional AI second-opinion
# feature on low-confidence / unmatched rows.

# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — defaults to a fast, low-cost model if not set.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional — enables POST /api/admin/reset, which wipes every collection,
# saved mapping, category, and source system. Without this set, that
# endpoint refuses to run at all. Pick any random string as the key, e.g.
# generate one with `openssl rand -hex 16`.
# ADMIN_RESET_KEY=
